# environment
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# regenerable: sha1-cached web fetches (flash.web refetches on demand)
benchmarks/cache/

# superseded partial census runs (the cited numbers come from the five logs
# left tracked under benchmarks/results/census/ — claims that name a log must
# have that log in the tree)
benchmarks/results/census/arm_*.log
benchmarks/results/census/arms.out
benchmarks/results/census/r42_100*.log

# R-6.4: LoRA weights are a 46MB-per-checkpoint artifact that `flash learn
# --lora` regenerates from the committed dataset, and the checkpoint dirs hold
# five of them per run. The small jsons (adapter_config, train_record) stay in
# the tree: they are what an arm cites when it names its weights.
benchmarks/results/adapters/**/*.safetensors

# packaging: a wheel is built by CI and published as a release artifact, never
# committed (the repo carries source + the logs a claim cites, nothing else)
build/
dist/
*.egg-info/
.venv-*/
