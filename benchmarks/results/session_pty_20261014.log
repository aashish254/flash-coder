=== final money.py ===
def cents_to_str(cents: int) -> str:
    if not isinstance(cents, int):
        raise ValueError("cents must be an integer")
    if cents >= 0:
        return f"${cents // 100}.{abs(cents) % 100:02d}"
    else:
        return f"-${abs(cents) // 100}.{abs(cents) % 100:02d}"
